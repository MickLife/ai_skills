<!-- ===================== 自动目录 + 滚动高亮 + 平滑跳转 ===================== -->
<script>
(function () {
  var content = document.getElementById("content");
  var toc = document.getElementById("toc");
  if (!content || !toc) return;
  var heads = content.querySelectorAll("h1, h2, h3, h4");
  var n = 0, items = [], byId = {};
  heads.forEach(function (h) {
    var id = h.id || ("sec-" + (++n));
    h.id = id;
    var level = parseInt(h.tagName.substring(1), 10);
    var a = document.createElement("a");
    a.href = "#" + id;
    a.className = "toc-link toc-l" + level;
    // 只取标题文本首行（忽略 .doc-sub 等子元素多余文本）
    a.textContent = (h.childNodes[0] && h.childNodes[0].nodeType === 3)
      ? h.childNodes[0].textContent.trim() : h.textContent.trim();
    a.title = a.textContent;
    toc.appendChild(a);
    items.push({ id: id, el: h });
    byId[id] = a;
  });
  toc.addEventListener("click", function (e) {
    var a = e.target.closest("a.toc-link");
    if (!a) return;
    e.preventDefault();
    var id = a.getAttribute("href").slice(1);
    var el = document.getElementById(id);
    if (el) {
      el.scrollIntoView({ behavior: "smooth", block: "start" });
      history.replaceState(null, "", "#" + id);
    }
  });
  if ("IntersectionObserver" in window) {
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) {
          var cur = toc.querySelector(".toc-link.active");
          if (cur) cur.classList.remove("active");
          var link = byId[en.target.id];
          if (link) {
            link.classList.add("active");
            // 保证激活项在侧栏可见
            var r = link.getBoundingClientRect(), sr = toc.parentElement.getBoundingClientRect();
            if (r.top < sr.top || r.bottom > sr.bottom) link.scrollIntoView({ block: "nearest" });
          }
        }
      });
    }, { rootMargin: "0px 0px -78% 0px", threshold: 0 });
    items.forEach(function (it) { obs.observe(it.el); });
  }
})();
</script>
